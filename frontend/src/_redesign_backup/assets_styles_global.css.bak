/* ═══════════════════════════════════════════════════════════════════════════
   F!NK Design System - AI Asset Management Platform
   Premium Pink/Purple Theme with Motion UI
   ═══════════════════════════════════════════════════════════════════════════ */

/* ═══════════════════════════════════════════════════════════════════════════
   Google Fonts - SF Pro Display Similar (Pretendard)
   ═══════════════════════════════════════════════════════════════════════════ */
@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css');

/* ═══════════════════════════════════════════════════════════════════════════
   1. CSS Variables - Design Tokens
   ═══════════════════════════════════════════════════════════════════════════ */
:root {
  /* ─────────────────────────────────────────────────────────────────────────
     구형 토큰 (잔여물)
     원래 70여 개가 있었으나, .vue 파일에서의 참조가 하나도 없었고 global.css
     안의 소비자(죽은 유틸·variant)를 지우자 대부분 참조 0이 되어 제거했다.
     아래 남은 것들은 navbar·스크롤바·타이포그래피 등 아직 살아있는 전역
     규칙이 쓰고 있어 남긴 것이며, 새 코드에서는 쓰지 않는다.
     새로 만드는 것은 전부 아래 --n-* 토큰을 쓴다.
     ───────────────────────────────────────────────────────────────────────── */
  --primary-600: #7469B6;

  --gray-100: #f5f5f7;
  --gray-200: #e8e8ed;
  --gray-300: #d2d2d7;
  --gray-400: #86868b;
  --gray-500: #6e6e73;
  --gray-700: #3d3d40;
  --gray-800: #1d1d1f;
  --gray-900: #0a0a0a;

  --bg-primary: #FDFBFD;
  --glass-bg: rgba(255, 255, 255, 0.72);

  /* Gradients — .navbar-brand 글자 그라데이션에만 남아있다 */
  --gradient-primary: linear-gradient(135deg, #FFE6E6 0%, #E1AFD1 35%, #AD88C6 70%, #7469B6 100%);

  /* Typography - Apple Style */
  --font-primary: 'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  --font-display: 'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;

  --space-sm: 8px;
  --space-lg: 24px;
  --space-xl: 32px;

  --radius-md: 12px;
  --radius-full: 9999px;

  --transition-fast: 200ms cubic-bezier(0.25, 0.1, 0.25, 1);

  --z-sticky: 200;

  /* ─────────────────────────────────────────────────────────────────────────
     디자인 토큰 (--n-*)
     화면에서 쓰는 색·반경은 전부 여기서 나온다. .vue 의 scoped style 에는
     색 리터럴(#fff 등)을 직접 쓰지 않는다 — 다크모드에서 뒤집히지 않아
     깨지기 때문이다. 다크모드 값은 아래 [data-theme="dark"] 에서 뒤집는다.
     ───────────────────────────────────────────────────────────────────────── */
  --n-bg: #ffffff;
  --n-bg-subtle: #fafaf9;
  --n-bg-sunken: #f2ecf7;
  --n-border: #e7e5e4;
  --n-border-strong: #d6d3d1;
  --n-text: #3c3c44;
  --n-text-body: #44403c;
  --n-text-muted: #78716c;
  --n-accent: #9588df;
  --n-accent-hover: #5B4E9E;
  --n-accent-wash: #faf5f9;
  --n-chatbot-bg: #d3d3f1;
  --n-ink: #dfdceb;
  --n-ink-text: #3a393d;

  /* ─────────────────────────────────────────────────────────────────────────
     브랜드 팔레트 (2026-09-29 메인 리디자인)
     라벤더(#d3d3f1)를 메인으로, 딥 인디고 네이비(#1c1b33)는 글자·버튼에 쓴다.
     순백 대신 라벤더 기운이 도는 캔버스를 바탕으로 깔아 흰 면적을 줄인다.
     메인에서 시작해 다른 화면도 이 토큰으로 옮겨간다.
     ───────────────────────────────────────────────────────────────────────── */
  --n-canvas: #f5f4fa;            /* 페이지 바탕 */
  --n-surface: #ffffff;           /* 캔버스 위 카드 */
  --n-line: #e4e3ef;              /* 캔버스·카드의 구분선 */
  --n-heading: #1c1b33;           /* 제목 */
  --n-copy: #4a4960;              /* 본문 */
  --n-copy-muted: #6b6a82;        /* 보조 본문 */

  --n-brand: #d3d3f1;             /* 메인 컬러 */
  --n-brand-soft: #ebebf9;        /* 아이콘 타일 */
  --n-brand-tint: #f3f2f3;        /* 추천 결과 목업 안의 칩·선택 행·배지 */
  --n-brand-strong: #4f4d9c;      /* 밝은 바탕 위 강조 글자 */
  --n-brand-panel: #d3d3f1;       /* 라벤더 면 (히어로 등) */
  --n-brand-panel-text: #1c1b33;
  --n-brand-panel-muted: #46456b;
  --n-brand-panel-line: #b9b9e0;

  --n-band: #e6e2ec;              /* 섹션 사이 띠 (옅은 라벤더 그레이) */
  --n-band-text: #1c1b33;
  --n-band-muted: #4f4a5e;
  --n-band-line: #d0cad8;

  --n-cta: #1c1b33;               /* 주요 버튼 */
  --n-cta-hover: #2e2d52;
  --n-on-cta: #ffffff;

  --n-shadow-md: 0 16px 40px -20px rgba(28, 27, 51, 0.22);
  --n-shadow-lg: 0 32px 64px -32px rgba(28, 27, 51, 0.35);

  /* accent 배경 위에 올라가는 글자색. --n-bg 는 다크에서 #272727 로
     뒤집히므로 여기에 쓸 수 없어 별도 토큰으로 고정한다. */
  --n-on-accent: #ffffff;

  /* 모서리 반경 스케일.
     리팩터링 전에는 8·10·12·14·16·20·24px 이 근거 없이 섞여 있었다.
     아래 4단계 안에서만 고른다. 원형(50%)과 알약(999px)은 예외로 인정한다. */
  --n-radius-sm: 8px;
  --n-radius-md: 12px;
  --n-radius-lg: 16px;
  --n-radius-xl: 20px;

  /* 의미색(성공/경고/오류/정보).
     장식이 아니라 상태를 전달하는 자리에만 쓴다. 배경은 옅은 틴트,
     글자는 진한 톤. 다크모드 값은 아래 [data-theme="dark"] 에서 뒤집는다. */
  --n-ok-bg: #f0fdf4;
  --n-ok-text: #15803d;
  --n-warn-bg: #fffbeb;
  --n-warn-text: #92400e;
  --n-danger-bg: #fef2f2;
  --n-danger-text: #b91c1c;
  --n-info-bg: #eff6ff;
  --n-info-text: #1d4ed8;
}

/* ═══════════════════════════════════════════════════════════════════════════
   2. Reset & Base Styles
   ═══════════════════════════════════════════════════════════════════════════ */

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body {
  font-family: var(--font-primary);
  font-weight: 400;
  background: var(--bg-primary);
  color: var(--gray-800);
  line-height: 1.5;
  min-height: 100vh;
  letter-spacing: -0.01em;
}

#app {
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-fast);
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
}

input, select, textarea {
  font-family: inherit;
  font-size: inherit;
}

ul, ol {
  list-style: none;
}

/* ═══════════════════════════════════════════════════════════════════════════
   3. Typography - Apple Style
   ═══════════════════════════════════════════════════════════════════════════ */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.1;
  color: var(--gray-900);
  letter-spacing: -0.025em;
}

h1 { 
  font-size: clamp(2.5rem, 5vw, 4rem); 
  font-weight: 700;
  letter-spacing: -0.04em;
}
h2 { 
  font-size: clamp(2rem, 4vw, 3rem); 
  letter-spacing: -0.03em;
}
h3 { 
  font-size: clamp(1.5rem, 3vw, 2rem); 
  letter-spacing: -0.02em;
}
h4 { font-size: 1.375rem; }
h5 { font-size: 1.125rem; }
h6 { font-size: 1rem; }

/* ═══════════════════════════════════════════════════════════════════════════
   4. Layout Utilities
   .container 만 남긴다(7곳 사용). flex, grid, gap, container 크기 변형,
   section 등 나머지 유틸과 text-gradient, text-sm 계열은
   마크업 사용 0회라 제거했다.
   ═══════════════════════════════════════════════════════════════════════════ */
.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 var(--space-lg);
}

/* ═══════════════════════════════════════════════════════════════════════════
   5. Button (무채색 리디자인 공용 컴포넌트)
   기존 전역 .btn-primary 는 --gradient-primary 핑크/퍼플 그라데이션 +
   그림자였다. 그런데 이 버튼을 쓰는 화면 10곳이 **전부** 지역 스타일로
   "background-image:none / box-shadow:none / transform:none" 을 덧발라
   그 그라데이션을 취소하고 있었다. 즉 아무도 원본을 원하지 않았다.
   그래서 전역 정의 자체를 --n-* 무채색으로 바꾸고, 각 화면의 취소 코드를
   전부 지웠다.

   마크업은 그대로 .btn / .btn-primary 를 쓴다. (n- 접두사를 붙이지 않은 이유:
   이미 14곳이 이 이름을 쓰고 있고, 이름이 겹치던 지역 정의는 이번에 전부
   삭제해 충돌 자체가 사라졌기 때문이다.)
   크기·여백·배치는 각 화면의 scoped 에 남긴다.
   ═══════════════════════════════════════════════════════════════════════════ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 20px;
  font-size: 0.9375rem;
  font-weight: 500;
  font-family: inherit;
  line-height: 1;
  border: 1px solid transparent;
  border-radius: var(--n-radius-sm);
  cursor: pointer;
  transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  outline: none;
}

.btn svg {
  width: 18px;
  height: 18px;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn:focus-visible {
  box-shadow: 0 0 0 3px var(--n-accent-wash);
}

/* Primary — 화면에서 가장 중요한 단 하나의 행동 */
.btn-primary {
  background: var(--n-accent);
  border-color: var(--n-accent);
  color: var(--n-on-accent);
}

.btn-primary:hover:not(:disabled) {
  background: var(--n-accent-hover);
  border-color: var(--n-accent-hover);
}

/* Secondary — 취소/보조 행동 */
.btn-secondary {
  background: var(--n-bg);
  border-color: var(--n-border);
  color: var(--n-text-body);
}

.btn-secondary:hover:not(:disabled) {
  border-color: var(--n-accent);
  color: var(--n-accent);
}

/* Ghost — 테두리 없는 최소 강조 */
.btn-ghost {
  background: transparent;
  border-color: transparent;
  color: var(--n-text-muted);
}

.btn-ghost:hover:not(:disabled) {
  background: var(--n-bg-subtle);
  color: var(--n-text);
}

/* Sizes */
.btn-sm { padding: 8px 14px; font-size: 0.875rem; }
.btn-lg { padding: 14px 24px; font-size: 1rem; }
.btn-icon { width: 40px; height: 40px; padding: 0; }
.btn-block { width: 100%; }

/* ═══════════════════════════════════════════════════════════════════════════
   6. Card (무채색 리디자인 공용 컴포넌트)
   "흰 배경 + 옅은 테두리 + 둥근 모서리" 라는 같은 껍데기가 88곳에 흩어져
   있었고 반경만 10·12·16·20·24px 다섯 가지로 제각각이었다. 이번에는 반경을
   토큰 4단계로 수렴시키고, 이 클래스는 앞으로 만드는 컴포넌트부터 쓴다.
   껍데기(배경·테두리·반경)만 여기 있고 padding 도 width 도 margin 도 없다 —
   안쪽 여백과 배치는 화면마다 다르므로 일부러 뺀 것이다 (scoped 의 몫).

   원래 있던 .card, .card-elevated, .card-glass 등은 구형 회색 토큰과
   그라데이션 기반인데다 마크업 사용도 0회여서 제거했다.
   (유일한 .card 사용처인 ProfileModify 는 자체 scoped .card 를 갖고 있다.)
   ═══════════════════════════════════════════════════════════════════════════ */
.n-card {
  background: var(--n-bg);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-md);
}

.n-card--lg { border-radius: var(--n-radius-lg); }
.n-card--xl { border-radius: var(--n-radius-xl); }

/* 한 단계 가라앉은 배경. 카드 안의 카드나 보조 패널용 */
.n-card--subtle { background: var(--n-bg-subtle); }

/* 클릭 가능한 카드. hover 에서 테두리만 진해진다(움직이지 않는다) */
.n-card--interactive {
  cursor: pointer;
  transition: border-color 0.18s ease;
}

.n-card--interactive:hover { border-color: var(--n-border-strong); }

/* ═══════════════════════════════════════════════════════════════════════════
   7. Form Input (무채색 리디자인 공용 컴포넌트)
   로그인·회원가입이 55줄짜리 동일한 블록을 바이트 단위로 똑같이 복사해
   갖고 있었고, 프로필수정은 거기서 값만 흘러내린 세 번째 사본이었다
   (반경 14px, 테두리 2px, 포커스링 4px). 로그인/회원가입 값을 정본으로 합쳤다.
   기존 전역 .input 은 --gray-100 배경 / 2px 투명 테두리라 세 파일 중 어디와도
   맞지 않았고 scoped 가 항상 이겨서 화면에 적용된 적이 한 번도 없다.
   그래서 고치는 게 아니라 통째로 교체했다.
   ═══════════════════════════════════════════════════════════════════════════ */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.input-label {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--n-text-muted);
}

/* 아이콘을 입력창 안쪽 왼쪽에 겹쳐 놓기 위한 기준점 */
.input-wrapper {
  position: relative;
}

.input-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  color: var(--n-text-muted);
  pointer-events: none;
}

.input {
  width: 100%;
  padding: 12px 14px;
  font-size: 0.9375rem;
  font-family: inherit;
  color: var(--n-text);
  background: var(--n-bg);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-sm);
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
  outline: none;
}

/* 아이콘이 붙은 입력창은 왼쪽 여백을 늘려 글자가 아이콘을 피하게 한다.
   input 요소에 직접 붙는 경우와 클래스로 붙는 경우 둘 다 지원 */
input.input-with-icon,
.input.input-with-icon {
  padding-left: 42px;
}

.input:hover:not(:focus) {
  border-color: var(--n-border-strong);
}

.input:focus {
  border-color: var(--n-accent);
  box-shadow: 0 0 0 3px var(--n-accent-wash);
}

.input::placeholder {
  color: var(--n-text-muted);
}

.input:disabled {
  background: var(--n-bg-subtle);
  color: var(--n-text-muted);
  cursor: not-allowed;
}

/* 8. Badge & Tag / 9. Tab 섹션은 제거했다.
   .badge·.tag 계열은 마크업 사용 0회였고, .tabs/.tab 은 유일한 사용처인
   ProductView.vue 가 scoped 에서 전부 재정의하고 있어(.tab.active 사용)
   전역 정의가 화면에 적용된 적이 없다. */

/* ═══════════════════════════════════════════════════════════════════════════
   10. Navigation Styles - Apple Style
   ═══════════════════════════════════════════════════════════════════════════ */
.navbar {
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
  background: var(--glass-bg);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.navbar-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 52px;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 var(--space-lg);
}

.navbar-brand {
  font-size: 1.5rem;
  font-weight: 700;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -0.04em;
}

.navbar-menu {
  display: flex;
  align-items: center;
  gap: 2px;
}

.navbar-link {
  padding: 8px 14px;
  font-size: 22px;
  font-weight: 400;
  color: var(--gray-800);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
  letter-spacing: -0.01em;
}

.navbar-link:hover {
  color: var(--gray-800);
  background: rgba(116, 105, 182, 0.06);
}

.navbar-link.router-link-active {
  color: var(--gray-800);
  background: rgba(116, 105, 182, 0.1);
  font-weight: 500;
}

.navbar-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

/* ═══════════════════════════════════════════════════════════════════════════
   11. Page Styles
   .page-header/.page-title/.page-subtitle 은 아래 21번 .n-page-header* 로
   대체되어 제거했다. .hero* 도 유일한 사용처인 HomeView.vue 가 scoped 에서
   배경까지 전부 재정의하고 있어(전역은 그라데이션, scoped 는 --n-bg) 제거했다.
   ═══════════════════════════════════════════════════════════════════════════ */
.page {
  min-height: calc(100vh - 52px);
  padding: var(--space-xl) 0;
}

/* ═══════════════════════════════════════════════════════════════════════════
   12. Animations (전역 단일 정의)
   Vue 의 <style scoped> 는 셀렉터만 스코프하고 @keyframes 이름은 전역으로
   새어나간다. 그래서 같은 이름을 10개 파일이 각자 정의해도 화면은 멀쩡하지만,
   실제로는 마지막에 로드된 하나가 나머지를 덮어쓰는 낭비였다.
   모든 @keyframes 는 이 섹션에만 둔다. 컴포넌트 scoped 에는 정의하지 않는다.

   반대로 원래 여기 있던 fadeIn/pulse/float 등 14개는 마크업에서 한 번도
   호출되지 않아(죽은 .animate-* 클래스만 참조) 함께 제거했다.
   ═══════════════════════════════════════════════════════════════════════════ */
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 로딩 상태 공용 컴포넌트.
   "데이터를 기다리는 중" 이라는 의미는 모든 화면에서 같으므로 전역이다.
   화면마다 다른 것은 이 블록을 어디에 몇 px 여백으로 놓느냐뿐이고,
   그건 각 파일의 scoped 에 남긴다. */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 24px;
  text-align: center;
  color: var(--n-text-muted);
  font-size: 0.875rem;
}

.loading-spinner {
  width: 48px;
  height: 48px;
  margin: 0 auto 16px;
  border: 4px solid var(--n-accent-wash);
  border-top-color: var(--n-accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 버튼 안 등 좁은 자리용 */
.loading-spinner--sm {
  width: 18px;
  height: 18px;
  margin: 0;
  border-width: 2px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   13. Utility Classes
   접근성용 .sr-only 만 남긴다. 나머지 유틸(.text-*, .flex*, .grid*, .mb-*,
   .p-*, .rounded*, .shadow* 등)은 마크업에서 한 번도 쓰이지 않아 제거했다.
   이 프로젝트는 유틸 클래스 방식이 아니라 컴포넌트 클래스 방식이다.
   ═══════════════════════════════════════════════════════════════════════════ */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ═══════════════════════════════════════════════════════════════════════════
   14. Responsive Design
   ═══════════════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  :root {
    --space-lg: 20px;
    --space-xl: 28px;
  }

  .navbar-menu {
    display: none;
  }

  .page {
    padding: var(--space-lg) 0;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   15. Scrollbar Styling
   ═══════════════════════════════════════════════════════════════════════════ */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--gray-300);
  border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--gray-400);
}

/* Firefox */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--gray-300) transparent;
}

/* ═══════════════════════════════════════════════════════════════════════════
   16. Print Styles
   ═══════════════════════════════════════════════════════════════════════════ */
@media print {
  .navbar,
  .btn,
  .no-print {
    display: none !important;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   19. Dark Mode Theme
   ═══════════════════════════════════════════════════════════════════════════ */
[data-theme="dark"] {
  /* Primary Pink/Purple Palette - Dark mode adjustments */
  --primary-600: #E1AFD1;

  /* Neutral Colors - Dark */
  --gray-100: #18181b;
  --gray-200: #27272a;
  --gray-300: #3f3f46;
  --gray-400: #52525b;
  --gray-500: #71717a;
  --gray-700: #d4d4d8;
  --gray-800: #e4e4e7;
  --gray-900: #fafafa;

  --bg-primary: #0a0a0a;
  --glass-bg: rgba(24, 24, 27, 0.85);
  --gradient-primary: linear-gradient(135deg, #7469B6 0%, #AD88C6 50%, #E1AFD1 100%);

  /* 디자인 토큰 (--n-*) - Dark */
  --n-bg: #272727;
  --n-bg-subtle: #191919;
  --n-bg-sunken: #202020;
  --n-border: #2a2a2a;
  --n-border-strong: #3a3a3a;
  --n-text: #fafaf9;
  --n-text-body: #d6d3d1;
  --n-text-muted: #a8a29e;
  --n-accent: #a394d8;
  --n-accent-hover: #bfb3e6;
  --n-accent-wash: #1e1b2a;
  --n-ink: #0a0a0a;
  --n-ink-text: #d6d3d1;

  /* 브랜드 팔레트 - Dark.
     라벤더 면은 다크에서 그대로 두면 너무 밝아 톤을 낮춘 인디고로 바꾸고,
     주요 버튼은 반대로 라벤더를 쓴다. --n-brand 는 원색 그대로 둔다. */
  --n-canvas: #14141c;
  --n-surface: #1d1d28;
  --n-line: #2b2a3b;
  --n-heading: #f4f4fb;
  --n-copy: #c9c8dc;
  --n-copy-muted: #9d9cb6;

  --n-brand-soft: #2a2944;
  --n-brand-tint: #2b2440;
  --n-brand-strong: #bcbbee;
  --n-brand-panel: #24233d;
  --n-brand-panel-text: #ececfa;
  --n-brand-panel-muted: #aeadd0;
  --n-brand-panel-line: #3b3a5e;

  --n-band: #2e2c37;
  --n-band-text: #f1f1fb;
  --n-band-muted: #b3afc2;
  --n-band-line: #423f4d;

  --n-cta: #d3d3f1;
  --n-cta-hover: #e4e4f7;
  --n-on-cta: #1c1b33;

  --n-shadow-md: 0 16px 40px -20px rgba(0, 0, 0, 0.55);
  --n-shadow-lg: 0 32px 64px -32px rgba(0, 0, 0, 0.6);

  /* 의미색 - Dark */
  --n-ok-bg: #12261a;
  --n-ok-text: #6ee7a8;
  --n-warn-bg: #2a2113;
  --n-warn-text: #e8c07a;
  --n-danger-bg: #2a1616;
  --n-danger-text: #f0a0a0;
  --n-info-bg: #15203a;
  --n-info-text: #93b4f5;

  /* accent 위 글자색은 다크에서도 흰색 그대로다 (뒤집지 않는다) */
  --n-on-accent: #ffffff;
}

/* Dark mode body styles */
[data-theme="dark"] body {
  background: var(--bg-primary);
  color: var(--gray-800);
}

/* Dark mode headings */
[data-theme="dark"] h1,
[data-theme="dark"] h2,
[data-theme="dark"] h3,
[data-theme="dark"] h4,
[data-theme="dark"] h5,
[data-theme="dark"] h6 {
  color: var(--gray-900);
}

/* 클래스 없는 raw input/select/textarea 를 위한 다크 대비.
   .input 클래스가 붙은 입력창은 --n-* 가 이미 다크에서 뒤집히므로 건드리지
   않아도 되지만, 클래스 없이 쓰인 요소들은 여기서 받쳐준다.
   (원래는 --gray-* 기반이라 새 .input 과 값이 어긋났다.) */
[data-theme="dark"] input,
[data-theme="dark"] select,
[data-theme="dark"] textarea {
  background: var(--n-bg);
  border-color: var(--n-border);
  color: var(--n-text);
}

[data-theme="dark"] input::placeholder,
[data-theme="dark"] textarea::placeholder {
  color: var(--n-text-muted);
}

[data-theme="dark"] input:focus,
[data-theme="dark"] select:focus,
[data-theme="dark"] textarea:focus {
  border-color: var(--n-accent);
  box-shadow: 0 0 0 3px var(--n-accent-wash);
}

/* Dark mode buttons */
[data-theme="dark"] .btn-ghost {
  color: var(--gray-700);
}

[data-theme="dark"] .btn-ghost:hover {
  background: var(--gray-200);
  color: var(--gray-900);
}

/* Dark mode scrollbar */
[data-theme="dark"] ::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

[data-theme="dark"] ::-webkit-scrollbar-track {
  background: var(--gray-100);
}

[data-theme="dark"] ::-webkit-scrollbar-thumb {
  background: var(--gray-400);
  border-radius: 4px;
}

[data-theme="dark"] ::-webkit-scrollbar-thumb:hover {
  background: var(--gray-500);
}

/* ═══════════════════════════════════════════════════════════════════════════
   21. Page Header (무채색 리디자인 공용 컴포넌트)
   상품/현물/주식/커뮤니티/AI분석/은행찾기/유튜브/뉴스 등 각 화면의
   페이지 헤더가 동일한 CSS를 10곳에 복사-붙여넣기 하고 있던 것을 통합.
   각 .vue 파일에서는 이 클래스들만 마크업에 붙이고, 화면 고유 요소
   (버튼·검색창·탭 등)만 그 파일의 scoped style에 남긴다.
   CommunityView.vue 를 기준으로 잡았다. 다른 페이지의 기존
   header-icon/header-text/page-title 클래스와 충돌하지 않도록
   n- 접두사를 쓴다.
   ═══════════════════════════════════════════════════════════════════════════ */
.n-page-header {
  background: var(--n-accent-wash);
  border-bottom: 1px solid var(--n-border);
  padding: 30px 24px;
}

.n-page-header-content {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 20px;
}

/* 제목 아래에 검색창/탭 등 부가 요소가 세로로 쌓이는 화면용
   (유튜브 검색/저장 등) */
.n-page-header-content--stack {
  flex-direction: column;
  align-items: stretch;
}

/* 제목 영역과 검색·탭 영역을 양끝에 배치하는 화면용 (뉴스) */
.n-page-header-content--split {
  justify-content: space-between;
  flex-wrap: wrap;
}

.n-page-header-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 60px;
  height: 60px;
  border: 1px solid var(--n-border);
  border-radius: 16px;
  background: var(--n-bg);
}

.n-page-header-icon svg {
  width: 32px;
  height: 32px;
  color: var(--n-text-muted);
}

.n-page-header-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.n-page-title {
  margin: 0;
  font-size: 1.6rem;
  font-weight: 600;
  color: var(--n-text);
  text-align: left;
}

.n-page-subtitle {
  margin: 0;
  font-size: 1rem;
  line-height: 1.6;
  color: var(--n-text-muted);
  text-align: left;
}

@media (max-width: 768px) {
  .n-page-header {
    padding: 32px 20px;
  }

  .n-page-header-content {
    flex-wrap: wrap;
    gap: 16px;
  }

  .n-page-header-icon {
    width: 48px;
    height: 48px;
  }

  .n-page-header-icon svg {
    width: 24px;
    height: 24px;
  }

  .n-page-title {
    font-size: 1.5rem;
  }

  .n-page-subtitle {
    font-size: 0.875rem;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   22. Empty State (무채색 리디자인 공용 컴포넌트)
   "보여줄 게 없다" 를 알리는 블록이 13곳에 거의 같은 모습으로 복사돼 있었다.
   유일하게 달랐던 건 원형 아이콘 배경의 색조뿐(기본 보라 / 삭제·오류는 빨강 /
   주의는 노랑)이라, 그 색조만 modifier 로 뽑고 나머지는 하나로 합쳤다.
   기본값은 accent(보라)이므로 대부분의 화면은 마크업을 고칠 필요가 없고,
   빨강·노랑을 쓰던 곳만 클래스 하나를 덧붙인다.
   ═══════════════════════════════════════════════════════════════════════════ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 24px;
  text-align: center;
  background: var(--n-bg);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-xl);
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  margin-bottom: 20px;
  border-radius: 50%;
  background: var(--n-accent-wash);
}

.empty-icon svg {
  width: 36px;
  height: 36px;
  color: var(--n-accent);
}

/* 아이콘 색조 변형. 상태의 의미가 다를 때만 쓴다.
   기본(보라)=중립 "아직 없음" / danger=저장 해제·삭제됨 / warn=조건 부족 */
.empty-state--danger .empty-icon { background: var(--n-danger-bg); }
.empty-state--danger .empty-icon svg { color: var(--n-danger-text); }

.empty-state--warn .empty-icon { background: var(--n-warn-bg); }
.empty-state--warn .empty-icon svg { color: var(--n-warn-text); }

.empty-state--muted .empty-icon { background: var(--n-bg-sunken); }
.empty-state--muted .empty-icon svg { color: var(--n-text-muted); }

.empty-title {
  margin: 0 0 6px;
  font-size: 1.0625rem;
  font-weight: 600;
  color: var(--n-text);
}

.empty-text {
  margin: 0;
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--n-text-muted);
}

/* ═══════════════════════════════════════════════════════════════════════════
   20. Reduced Motion
   OS에서 "동작 줄이기"를 켠 사용자에게만 적용된다. 일반 사용자에게는
   제휴은행 마퀴를 포함한 모든 모션이 그대로 동작한다.
   ═══════════════════════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}