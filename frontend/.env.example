# ==========================================
# F!NK Frontend 환경변수
# ==========================================
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
#   cp .env.example .env

# ------------------------------------------
# 목업 모드 (기본 ON)
# ------------------------------------------
# 백엔드 없이 데모 데이터로 전 화면을 둘러볼 수 있습니다.
# .env 가 없어도 기본으로 켜져 있으므로 별도 설정이 필요 없습니다.
# 데모 계정: admin / 비밀번호는 아무 값
#
# Django 백엔드를 띄워 실제 API 를 사용할 때만 아래 주석을 해제하세요.
# VITE_USE_MOCK=false

# ------------------------------------------
# 외부 API 키 (목업 모드에서는 불필요)
# ------------------------------------------
# 카카오맵 JavaScript 키 — 은행찾기 지도
# VITE_KAKAO_API_KEY=

# 카카오 REST API 키 — 길찾기(경로 안내)
# VITE_KAKAO_REST_API_KEY=

# YouTube Data API v3 키 — 유튜브 검색
# VITE_YOUTUBE_API_KEY=
